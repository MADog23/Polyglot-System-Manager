{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polyglot System Manager Data Schema",
  "type": "object",
  "properties": {
    "Snapshot": {
      "type": "object",
      "properties": {
        "timestamp": { "type": "number" },
        "system": { "$ref": "#/$defs/SystemMetrics" },
        "processes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProcessInfo" }
        }
      },
      "required": ["timestamp", "system", "processes"]
    },

    "Alert": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "type", "severity", "message", "timestamp"]
    },

    "Summary": {
      "type": "object",
      "properties": {
        "cpu_avg": { "type": "number" },
        "memory_avg_mb": { "type": "number" },
        "window_sec": { "type": "number" }
      },
      "required": ["cpu_avg", "memory_avg_mb", "window_sec"]
    }
  },

  "$defs": {
    "SystemMetrics": {
      "type": "object",
      "properties": {
        "cpu_usage_percent": { "type": "number" },
        "memory_used_mb": { "type": "number" },
        "memory_total_mb": { "type": "number" },
        "disk_read_mb_s": { "type": "number" },
        "disk_write_mb_s": { "type": "number" },
        "net_in_kb_s": { "type": "number" },
        "net_out_kb_s": { "type": "number" }
      },
      "required": [
        "cpu_usage_percent",
        "memory_used_mb",
        "memory_total_mb",
        "disk_read_mb_s",
        "disk_write_mb_s",
        "net_in_kb_s",
        "net_out_kb_s"
      ]
    },

    "ProcessInfo": {
      "type": "object",
      "properties": {
        "pid": { "type": "number" },
        "name": { "type": "string" },
        "cpu_percent": { "type": "number" },
        "memory_mb": { "type": "number" }
      },
      "required": ["pid", "name", "cpu_percent", "memory_mb"]
    }
  }
}
